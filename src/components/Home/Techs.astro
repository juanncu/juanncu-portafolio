---
import LabelHover from "../LabelHover.astro"
import Angular from "../../../public/svgs/techs/Angular.astro"
import Csharp from "../../../public/svgs/techs/Csharp.astro"
import Dotnet from "../../../public/svgs/techs/Dotnet.astro"
import Java from "../../../public/svgs/techs/Java.astro"
import Spring from "../../../public/svgs/techs/Spring.astro"
import TypeScript from "../../../public/svgs/techs/TypeScript.astro"
---
<!-- title secction -->
<div class="flex flex-row min-w-full justify-center items-center gap-6 sm:gap-8">
  <div class="w-[260px] h-[1px] bg-white"></div>
  <p class="text-xl sm:text-2xl font-bold font-syne">Tecnologías</p>
  <div class="w-[260px] h-[1px] bg-white"></div>
</div>
<!-- svgs techs -->
<div class="flex flex-row gap-5 sm:gap-12 min-w-full flex-wrap justify-center items-center">
    <!-- C# -->
  <div class="label">
    <LabelHover title="C#"/>
    <Csharp/>    
  </div>
  <!-- .NET -->
  <div class="label">
    <LabelHover title=".NET"/>
    <Dotnet/>
  </div>
  <!-- ANGULAR -->
  <div class="label">
    <LabelHover title="Angular"/>
    <Angular/>
  </div>
  <!-- Java -->
  <div class="label">
    <LabelHover title="Java"/>
    <Java/>
  </div>
  <!-- Spring Boot -->
  <div class="label">
    <LabelHover title="Spring Boot"/>
    <Spring/>
  </div>
  <!-- TypeScript -->
  <div class="label">
    <LabelHover title="TypeScript"/>
    <TypeScript/>
  </div>
</div>