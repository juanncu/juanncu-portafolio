---
import LabelHover from "../LabelHover.astro"
import Angular from "../../../public/svgs/techs/angu.astro"
import Csharp from "../../../public/svgs/techs/sharp.astro"
import Dotnet from "../../../public/svgs/techs/net.astro"
import Java from "../../../public/svgs/techs/javaa.astro"
import Spring from "../../../public/svgs/techs/sprin.astro"
import React from "../../../public/svgs/techs/react.astro"
---
<!-- title secction -->
<div class="flex flex-row min-w-full justify-center items-center gap-6 sm:gap-8">
  <div class="w-[260px] h-[1px] bg-white"></div>
  <p class="text-xl sm:text-2xl font-bold font-syne">Tecnologías</p>
  <div class="w-[260px] h-[1px] bg-white"></div>
</div>
<!-- svgs techs -->
<div class="flex flex-row gap-5 sm:gap-12 min-w-full flex-wrap justify-center items-center">
    <!-- C# -->
  <div class="label">
    <LabelHover title="C#"/>
    <Csharp/>    
  </div>
  <!-- .NET -->
  <div class="label">
    <LabelHover title=".NET"/>
    <Dotnet/>
  </div>
  <!-- ANGULAR -->
  <div class="label">
    <LabelHover title="Angular"/>
    <Angular/>
  </div>
  <!-- Java -->
  <div class="label">
    <LabelHover title="Java"/>
    <Java/>
  </div>
  <!-- Spring Boot -->
  <div class="label">
    <LabelHover title="Spring Boot"/>
    <Spring/>
  </div>
  <!-- React -->
  <div class="label">
    <LabelHover title="React"/>
    <React/>
  </div>
</div>